# 通用的env 文件
REACT_APP_API_URL_OSS=https://oss-saas.carbonstop.net
# 帮助中心
REACT_APP_HELP_DOCUMENT_LINK=https://carbonstop.feishu.cn/wiki/wikcny2F7yEJN35P0Z7SbwPzs7c
# Carbon Agent 用户操作手册
REACT_APP_AGENT_MANUAL_URL=https://carbonstop.feishu.cn/wiki/UgsKwoG2fitZjskq2cLcGUyKnmc

# IconFont cdn codedesign
REACT_APP_ICON_FONT=https://cdn3.codesign.qq.com/icons/na4Jd0NaMK9AMkb/latest/iconfont.js
# 备用地址
# REACT_APP_ICON_FONT=https://oss-saas.carbonstop.net/iconfont/iconfont-saas.js

# alibaba iconfont
REACT_APP_ICON_FONT_ALIBABA=https://oss-saas.carbonstop.net/iconfont/iconfont-alibaba.js

# 部署形态覆盖（留空 = 按域名自动判定：agent* -> agent，其余 -> cloud）
REACT_APP_DEPLOY_MODE=

# WPS WebOffice agent 侧覆盖（留空 = 回退上面的公共值）
REACT_APP_WPS_APP_ID_AGENT=
REACT_APP_WPS_API_URL_AGENT=
